[Unit]
Description=西游团队生产看板
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/lib/game-team-board
EnvironmentFile=/etc/game-team-board.env
ExecStart=/usr/bin/python3 /opt/game-team-board/app.py --host 127.0.0.1 --port 4312 --database /var/lib/game-team-board/tasks.db
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/game-team-board

[Install]
WantedBy=multi-user.target
